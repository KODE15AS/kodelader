# Nexi Checkout (Nets Easy) — bruk test-nøkler i sandkassen, live-nøkler kun på Raven
NEXI_API_BASE=https://test.api.dibspayment.eu
NEXI_SECRET_KEY=
NEXI_CHECKOUT_KEY=

# Hemmelighet vi selv velger — Nexi sender den tilbake i webhook Authorization-headeren
# NB: Nexi krever 8–32 tegn, kun bokstaver og sifre
WEBHOOK_AUTH=

# Offentlig base-URL (bak web-gateway fra 06.11.2026; Funnel-adressen var
# https://cadify104raven.tail14de1b.ts.net/kodelader frem til da)
BASE_URL=https://kodelader.kode15.app

# Porter (offentlig app og tailnett-admin)
PUBLIC_PORT=8096
ADMIN_PORT=8097

# SQLite-database
DB_PATH=./data/kodelader.sqlite

# CSMS (OCPP 2.0.1, Security Profile 2): kjente stasjoner og Basic Auth-passord.
# Format: <stasjonsidentitet>=<passord>,... — identiteten er nøyaktig det laderen
# legger bakerst i URL-en (wss://lading.kode15.app/ocpp/<identitet>).
# Passord: kun bokstaver/sifre (komma og likhetstegn er skilletegn). Tom = alle avvises.
OCPP_STASJONER=

# GatewayAPI SMS (EU-plattformen) — tomt token = SMS deaktivert (logges bare)
# NB: URL-er i meldinger (kvitteringslenken!) må hvitelistes i GatewayAPI-dashbordet først
GATEWAYAPI_TOKEN=
SMS_SENDER=KODE15
